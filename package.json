{
  "name": "cdk-starter",
  "version": "0.0.0",
  "private": true,
  "description": "CDK Starter with pnpm workspaces and Turborepo",
  "scripts": {
    "prepare": "husky",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "cdk:diff:dev": "turbo cdk:diff:dev",
    "cdk:diff:stage": "turbo cdk:diff:stage",
    "cdk:diff:prod": "turbo cdk:diff:prod",
    "cdk:deploy:dev": "turbo cdk:deploy:dev",
    "cdk:deploy:stage": "turbo cdk:deploy:stage",
    "cdk:deploy:prod": "turbo cdk:deploy:prod"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.0.1",
    "@typescript-eslint/parser": "7.0.1",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-prettier": "5.1.3",
    "husky": "9.0.11",
    "prettier": "3.2.5",
    "tsx": "catalog:",
    "turbo": "2.5.4",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.12.1"
}
